    write_yaml(plan_dir / "status.yaml", status)
    if args.comment:
        append_note(
            plan_dir,
            "decision",
            args.comment,
            "Draft approval comment.",
            ["draft.md", "status.yaml#phase"],
            "co planner approve-draft",
        )
    append_event(
        plan_dir,
        "draft_approved",
        "Draft approved and planning phase opened.",
        ["draft.md", "status.yaml#phase"],
        "co planner approve-draft",
    )
    print_result(
        {"phase": "planning"},
        "Run `co planner validate`, then `co planner finalize`.",
        "co planner validate",
    )


def planner_finalize(_args):
    _, plan_dir = active_plan()
    require_interview_closed(plan_dir, "planner finalize")
    validate_draft_markdown(plan_dir)
    plan = load_yaml(plan_dir / "plan.yaml")
    tasks = load_yaml(plan_dir / "tasks.yaml")
    status = load_yaml(plan_dir / "status.yaml")
    validate_plan(plan)
    validate_tasks(tasks)
    validate_status(status, tasks)
    require_draft_approved(status)
    require_review_passed(plan_dir, status, "planner finalize")
    status["phase"] = "ready_for_exec"
    write_yaml(plan_dir / "status.yaml", status)
    append_event(
        plan_dir,
        "bundle_finalized",
        "Bundle finalized and ready for execution.",
        ["status.yaml#phase"],
        "co planner finalize",
    )
    print_result(
        {"phase": "ready_for_exec"},
        "Planning is finalized. Switch to the `coexec` skill and start with `co exec status`.",
        "co exec status",
    )


def planner_validate(_args):
    _, plan_dir = active_plan()
    require_interview_closed(plan_dir, "planner validate")
    validate_draft_markdown(plan_dir)
    plan = load_yaml(plan_dir / "plan.yaml")
    tasks = load_yaml(plan_dir / "tasks.yaml")
    status = load_yaml(plan_dir / "status.yaml")
    validate_plan(plan)
    validate_tasks(tasks)
    validate_status(status, tasks)
    print_result(
        {"validated": ["draft.md", "plan.yaml", "tasks.yaml", "interview.yaml", "status.yaml"]},
        "If pre-draft review has not passed, run `co planner review run --stage pre-draft`; otherwise continue approval or finalize.",
    )


def planner_review_run(args):
    _, plan_dir = active_plan()
    if args.stage != "pre-draft":
        raise ExError("planner review supports only --stage pre-draft")
    require_interview_closed(plan_dir, "planner review")
    validate_draft_markdown(plan_dir)
    plan = load_yaml(plan_dir / "plan.yaml")
    tasks = load_yaml(plan_dir / "tasks.yaml")
    status = load_yaml(plan_dir / "status.yaml")
    validate_plan(plan)
    validate_tasks(tasks)
    validate_status(status, tasks)

    reviewer_outputs = run_codex_agents_parallel(
        [
            {
                "role": reviewer,
                "prompt": reviewer_prompt(plan_dir, reviewer),
                "schema": review_schema(),
            }
            for reviewer in REQUIRED_REVIEWERS
        ],
        cwd=Path.cwd(),
    )

    results = []
    passed_reviewers = []
    for reviewer in REQUIRED_REVIEWERS:
        result = reviewer_outputs[reviewer]["output"]
        review_status = result["status"]
        if review_status == "PASS":
            passed_reviewers.append(reviewer)
        results.append({"reviewer": reviewer, **result})
        append_note(
            plan_dir,
            "decision" if review_status == "PASS" else "risk",
            f"{reviewer} {review_status}: {result['summary']}",
            "Codex CLI pre-draft plan review.",
            ["plan.yaml", "tasks.yaml"],
            "co planner review run",
        )
        append_event(
            plan_dir,
            "planner_review_recorded",
            f"{reviewer} returned {review_status}.",
            ["status.yaml#review", "notes.yaml"],
            "co planner review run",
        )

    previous_status = status
    status = load_yaml(plan_dir / "status.yaml")
    status["review"] = {
        **default_review_state(),
        "status": "passed" if len(passed_reviewers) == len(REQUIRED_REVIEWERS) else "failed",
        "stage": "pre-draft",
        "required_reviewers": list(REQUIRED_REVIEWERS),
        "passed_reviewers": passed_reviewers,
        "last_run_id": next_review_run_id(previous_status),
        "fingerprint": review_fingerprint(plan_dir) if len(passed_reviewers) == len(REQUIRED_REVIEWERS) else None,
    }
    validate_status(status, tasks)
    write_yaml(plan_dir / "status.yaml", status)
    if status["review"]["status"] == "passed":
        append_event(
            plan_dir,
            "planner_review_passed",
            "All required Codex CLI pre-draft reviewers passed.",
            ["status.yaml#review"],
            "co planner review run",
        )
    if status["review"]["status"] == "passed":
        required_action = "Show `draft.md` to the user with `co show --file draft`; after approval, run `co planner approve-draft --comment \"...\"`."
        next_command = "co show --file draft"
    else:
        required_action = "Patch valid reviewer findings in draft.md, plan.yaml, or tasks.yaml, then rerun pre-draft review."
        next_command = "co planner review run --stage pre-draft"
    print_result(
        {"ok": status["review"]["status"] == "passed", "review": status["review"], "results": results},
        required_action,
        next_command,
    )


def planner_review_status(_args):
    _, plan_dir = active_plan()
    status = load_yaml(plan_dir / "status.yaml")
    validate_status(status, load_yaml(plan_dir / "tasks.yaml"))
    if status["review"]["status"] == "passed":
        required_action = "Continue user draft review or draft approval."
    else:
        required_action = "Run or rerun `co planner review run --stage pre-draft` after fixing bundle files."
    print_result({"review": status["review"]}, required_action)


